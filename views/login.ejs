  <%- include('partials/header') %>

    <div class="login-box">
      <h1>Admin Login</h1>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form action="/admin/login" method="POST">
        <label>Password</label>
        <input type="password" name="password" required>

        <button type="submit">Login</button>
      </form>
    </div>

  <%- include('partials/footer') %>