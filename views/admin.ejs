<%- include('partials/header') %>

<h1>Admin Dashboard</h1>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<div class="upload-box">
  <h2>Upload New Book</h2>
  <form id="uploadForm">
    <label>Title</label>
    <input type="text" id="title" required>

    <label>Author</label>
    <input type="text" id="author" required>

    <label>Cover Image</label>
    <input type="file" id="cover" accept="image/*" required>

    <label>PDF File</label>
    <input type="file" id="pdf" accept=".pdf" required>

    <button type="submit" id="submitBtn">Upload Book</button>
    <p id="statusMsg"></p>
  </form>
</div>

<div class="book-list">
  <h2>All Books</h2>
  <table>
    <tr>
      <th>Title</th>
      <th>Author</th>
      <th>Downloads</th>
      <th>Action</th>
    </tr>
    <% books.forEach(function(book) { %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.downloads %></td>
        <td>
          <form action="/admin/delete/<%= book._id %>" method="POST">
            <button type="submit" class="delete-btn">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </table>
</div>

<p><a href="/admin/logout">Logout</a></p>

<script>
  const CLOUD_NAME = "<%= cloudName %>";
  const PRESET = "<%= uploadPreset %>";

  const form = document.getElementById('uploadForm');
  const statusMsg = document.getElementById('statusMsg');
  const submitBtn = document.getElementById('submitBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    statusMsg.innerText = "Uploading files to cloud storage...";

    try {
      const coverFile = document.getElementById('cover').files[0];
      const coverData = new FormData();
      coverData.append('file', coverFile);
      coverData.append('upload_preset', PRESET);

      const coverRes = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, {
        method: 'POST',
        body: coverData
      });
      const coverJson = await coverRes.json();

      const pdfFile = document.getElementById('pdf').files[0];
      const pdfData = new FormData();
      pdfData.append('file', pdfFile);
      pdfData.append('upload_preset', PRESET);

      const pdfRes = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/raw/upload`, {
        method: 'POST',
        body: pdfData
      });
      const pdfJson = await pdfRes.json();

      statusMsg.innerText = "Saving book record...";
      const response = await fetch('/admin/upload', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: document.getElementById('title').value,
          author: document.getElementById('author').value,
          coverUrl: coverJson.secure_url,
          pdfUrl: pdfJson.secure_url
        })
      });

      if (response.ok) {
        window.location.reload();
      } else {
        statusMsg.innerText = "Failed to save book to database.";
        submitBtn.disabled = false;
      }
    } catch (err) {
      console.error(err);
      statusMsg.innerText = "Upload failed. Check your network console.";
      submitBtn.disabled = false;
    }
  });
</script>

<%- include('partials/footer') %>